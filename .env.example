# Required only as optional defaults. Each npm start asks in the terminal.
GPT_URL=
CURSOR_URL=

# Browser: edge (default) or chrome
BROWSER=edge

# Connect to browser started with remote debugging
CDP_URL=http://127.0.0.1:9222

# Stop when GPT prints this
STOP_PHRASE=Automation Done

# Max concurrent GPT↔Cursor pairs (each uses 2 tabs). Default 5 = 10 tabs.
MAX_AGENTS=5

# Telegram (required for: npm run telegram)
# 1) Create bot via @BotFather → paste token
# 2) Chat id:
#    - Private: message the bot, then read chat.id from getUpdates
#    - Group: add the bot to the group; id is negative (e.g. -5161056514)
#      From Telegram Web URL: web.telegram.org/k/#-5161056514 → TELEGRAM_CHAT_ID=-5161056514
# 3) Groups: in @BotFather → /setprivacy → Disable (so /run can receive pasted URLs)
#    Or always put both links in one message: /run <gpt> <cursor>
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional extra allowed chats (comma-separated). TELEGRAM_CHAT_ID is always allowed.
# TELEGRAM_ALLOWED_CHAT_IDS=

# Timeouts
# Cursor: 60 minutes
CURSOR_REPLY_TIMEOUT_MS=3600000
# GPT: 20 minutes
GPT_REPLY_TIMEOUT_MS=1200000
# Status poll interval: 60 seconds
POLL_INTERVAL_MS=60000
# Login / hard-blocker wait: 20 minutes
LOGIN_WAIT_MS=1200000

# Optional overrides
# GPT_CURSOR_BROWSER_DIR=
# BROWSER_PROFILE_DIRECTORY=Default
