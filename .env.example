# Required URLs
GPT_URL=https://chatgpt.com/c/6a7b03a4-1650-83ee-aa2f-7cf42012dc5d
CURSOR_URL=https://cursor.com/agents/bc-bcf89552-31d7-414b-af4c-c5ba7443f517

# Connect to Chrome you already started with remote debugging
CDP_URL=http://127.0.0.1:9222

# Stop phrase from GPT (exact text GPT was told to print)
STOP_PHRASE=Automation Done

# How long to wait for Cursor / GPT replies (ms)
# Cursor default: 40 minutes
CURSOR_REPLY_TIMEOUT_MS=2400000
GPT_REPLY_TIMEOUT_MS=600000
# Wait for manual popups (GitHub / Telegram token / chat id): 20 minutes
LOGIN_WAIT_MS=1200000

# Optional: Chrome profile directory if using launch mode instead of CDP
# CHROME_USER_DATA_DIR=
# CHROME_PROFILE_DIRECTORY=Default
