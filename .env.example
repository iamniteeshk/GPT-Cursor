# Required only as optional defaults. Each npm start asks in the terminal.
GPT_URL=
CURSOR_URL=

# Browser: edge (default) or chrome
BROWSER=edge

# Connect to browser started with remote debugging
CDP_URL=http://127.0.0.1:9222

# Stop when GPT prints this
STOP_PHRASE=Automation Done

# Optional Telegram secrets (or use secrets.local.json)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Timeouts
# Cursor: 60 minutes
CURSOR_REPLY_TIMEOUT_MS=3600000
# GPT: 20 minutes
GPT_REPLY_TIMEOUT_MS=1200000
# Status poll interval: 60 seconds
POLL_INTERVAL_MS=60000
# Login / hard-blocker wait: 20 minutes
LOGIN_WAIT_MS=1200000

# Optional overrides
# GPT_CURSOR_BROWSER_DIR=
# BROWSER_PROFILE_DIRECTORY=Default
